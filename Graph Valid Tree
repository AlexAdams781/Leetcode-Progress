# https://leetcode.com/problems/graph-valid-tree/description/
'''
This requires DFS and not just BFS because you need to keep track of the path
from the root to the current node.  When you encounter a node in the path then
a cycle was detected and return false.

There are only two edge cases to keep in mind.
1) The code needs to return false if not all nodes were visited because
   graph is disconnected
2) It's okay if the current node is in the path if it was the last node reached.
   Only go to neighbors that aren't the last node.
'''
class Solution:
    def validTree(self, n: int, edges: List[List[int]]) -> bool:
        G = defaultdict(set)
        for e in edges:
            G[e[0]].add(e[1])
            G[e[1]].add(e[0])
        
        visited = set()
        def dfs(x, path, last):
            if x in path:
                return False
            path.append(x)
            visited.add(x)
            for n in G[x]:
                if n != last and not dfs(n, path, x):
                    return False
            path.pop()
            return True

        res = dfs(0, [], None)

        return res and len(visited) == n
