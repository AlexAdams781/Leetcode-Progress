# https://leetcode.com/problems/longest-substring-of-all-vowels-in-order/
'''
Sliding Window algorithm extends window if vowel is current or next.
Keeps track of current vowel
Resets if wrong vowel reached.
'''
class Solution:
    def longestBeautifulSubstring(self, word: str) -> int:
        D = {
            0 : "a",
            1 : "e",
            2 : "i",
            3 : "o",
            4 : "u" 
        }
        maxLen = 0

        left = 0
        while left < len(word) and word[left] != "a":
            left += 1
        right = left
        v_index = 0
        
        while right < len(word):
            if v_index != 4 and word[right] == D[v_index+1]:
                v_index += 1
                right += 1
            elif word[right] == D[v_index]:
                right += 1
            else:
                if v_index == 4:
                    maxLen = max(maxLen, right-left)
                v_index = 0
                left = right
                while left < len(word) and word[left] != "a":
                    left += 1
                right = left

        if v_index == 4:
            maxLen = max(maxLen, right-left)
        
        return maxLen
